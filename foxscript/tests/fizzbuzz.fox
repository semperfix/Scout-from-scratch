for (let i = 1; i <= 15; i = i + 1) {
  if (i % 15 == 0) { print("fizzbuzz"); }
  else if (i % 3 == 0) { print("fizz"); }
  else if (i % 5 == 0) { print("buzz"); }
  else { print(i); }
}
// => 1
// => 2
// => fizz
// => 4
// => buzz
// => fizz
// => 7
// => 8
// => fizz
// => buzz
// => 11
// => fizz
// => 13
// => 14
// => fizzbuzz
